#!/usr/bin/env bash
# PortPilot starten — baut bei Bedarf, startet den Server und oeffnet den Browser.
set -euo pipefail

PORT="${PORTPILOT_PORT:-7070}"
HOST="127.0.0.1"
URL="http://${HOST}:${PORT}"

# Installationsverzeichnis aus dem Ort dieses Skripts ableiten, damit der
# Aufruf aus jedem Arbeitsverzeichnis funktioniert (z.B. aus dem Anwendungsmenue).
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
APP_DIR="$(dirname "$(dirname "$SCRIPT_PATH")")"
cd "$APP_DIR"

log() { printf '\033[36m[portpilot]\033[0m %s\n' "$1"; }
err() { printf '\033[31m[portpilot]\033[0m %s\n' "$1" >&2; }

open_browser() {
    command -v xdg-open >/dev/null 2>&1 && xdg-open "$URL" >/dev/null 2>&1 &
}

# Laeuft bereits eine Instanz? Dann nur das Fenster oeffnen.
if curl -sf --max-time 2 "${URL}/api/health" >/dev/null 2>&1; then
    log "Laeuft bereits auf ${URL} — oeffne Browser."
    open_browser
    exit 0
fi

# Belegt ein fremder Prozess den Port?
if ss -tln 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${PORT}\$"; then
    err "Port ${PORT} ist belegt, aber es antwortet kein PortPilot."
    err "Anderen Port waehlen:  PORTPILOT_PORT=7171 $0"
    exit 1
fi

# Docker erreichbar?
if [[ ! -S /var/run/docker.sock ]]; then
    err "Docker-Socket nicht gefunden. Daemon starten:  sudo systemctl start docker"
    exit 1
fi
if ! docker info >/dev/null 2>&1; then
    err "Kein Zugriff auf die Docker-Engine."
    err "Daemon starten (sudo systemctl start docker) oder Benutzer in die Gruppe 'docker' aufnehmen."
    exit 1
fi

command -v node >/dev/null 2>&1 || { err "Node.js nicht gefunden."; exit 1; }

[[ -d node_modules ]] || { log "Installiere Abhaengigkeiten…"; npm install --no-audit --no-fund; }

# Neu bauen, wenn dist fehlt oder eine Quelldatei juenger ist als das Bundle.
needs_build=0
if [[ ! -f dist/server.cjs || ! -f dist/index.html ]]; then
    needs_build=1
elif [[ -n "$(find src server server.ts index.html package.json -newer dist/server.cjs 2>/dev/null | head -1)" ]]; then
    needs_build=1
fi

if [[ $needs_build -eq 1 ]]; then
    log "Baue Anwendung…"
    npm run build
fi

log "Starte auf ${URL} (Beenden mit Strg+C)"
open_browser
exec env NODE_ENV=production PORT="$PORT" HOST="$HOST" node dist/server.cjs
